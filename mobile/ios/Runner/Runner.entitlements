<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Set by Xcode when the Push Notifications capability is enabled; "production"
	     for TestFlight/App Store, "development" for a debug build on a device. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
